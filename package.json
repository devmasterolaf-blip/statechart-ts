{
  "name": "statechart-ts",
  "version": "0.1.0",
  "description": "A small typed statechart library: hierarchical and parallel states, history, delayed transitions, an interpreter, validation and diagram export.",
  "license": "MIT",
  "author": "devmasterolaf-blip",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
